{
  "manifest_version": 3,
  "name": "LV Crawler Bridge",
  "version": "1.0",
  "description": "Anti-detect crawler bridge for LV",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.louisvuitton.com/*",
    "http://localhost:8899/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.louisvuitton.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
