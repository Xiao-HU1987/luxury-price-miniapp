# 后端环境变量配置模板
# ============================================================
# 本地开发：复制此文件为 .env，使用 SQLite（见下方示例）
# 云托管生产：在「微信云托管控制台 > 服务设置 > 环境变量」中配置，
#             不要把生产凭据写到 .env（.env 已被 .gitignore 排除）
# ============================================================

# ==================== 必填配置 ====================

# JWT 密钥（生产环境请更换为 32 位以上随机字符串）
SECRET_KEY=your-secret-key-change-this-in-production

# 数据库连接
# --- 本地开发（SQLite，无需额外服务）---
# DATABASE_URL=sqlite:///./database.db
#
# --- 生产环境（微信云托管 MySQL）---
# 格式：mysql+pymysql://用户名:密码@内网地址:端口/数据库名
# 微信云托管 MySQL 内网地址形如：mysql-xxxx.mysql.ap-shanghai.internal
# 端口默认 3306
DATABASE_URL=mysql+pymysql://root:password@mysql-xxxx.mysql.ap-shanghai.internal:3306/luxury_price

# 微信小程序 AppID（必填，云托管生产环境必须配置真实值）
WECHAT_APPID=wx1234567890abcdef

# 微信小程序 AppSecret（必填）
WECHAT_SECRET=your-appsecret-here

# ==================== 微信支付配置（如需支付功能） ====================

# 微信支付商户号
WECHAT_MCH_ID=1234567890

# 微信支付 API 密钥（v2）
WECHAT_PAY_KEY=your-pay-key-32-characters

# 微信支付回调地址（必须是 HTTPS，填云托管默认域名或自定义域名）
WECHAT_NOTIFY_URL=https://你的域名.com/api/order/pay/notify

# ==================== 可选配置 ====================

# Token 有效期（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 调试模式（生产环境必须为 False）
DEBUG=False
