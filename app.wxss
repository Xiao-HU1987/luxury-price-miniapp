page {
  background-color: #F0EDEA;
  font-family: 'Inter', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', system-ui, -apple-system, sans-serif;
  font-size: 28rpx;
  color: #2C2C2C;
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
  -webkit-font-smoothing: antialiased;
}

.safe-area-top {
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
}

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.container {
  padding: 32rpx;
  box-sizing: border-box;
}

.text-primary {
  color: #2C2C2C;
}

.text-secondary {
  color: #6B6B6B;
}

.text-tertiary {
  color: #9E9E9E;
}

.text-accent {
  color: #C8553D;
}

.text-accent-light {
  color: #E8765F;
}

.text-gold {
  color: #C5A47E;
}

.text-inverse {
  color: #FFFFFF;
}

.text-danger {
  color: #E53935;
}

.text-flag-cn {
  color: #DE2910;
}

.text-flag-jp {
  color: #C8553D;
}

.bg-accent {
  background-color: #C8553D;
}

.bg-accent-pale {
  background-color: #FFF0ED;
}

.bg-secondary {
  background-color: #F7F5F2;
}

.bg-card {
  background-color: #FFFFFF;
}

.bg-dark {
  background-color: #1A1A1A;
}

.bg-warm {
  background-color: #FDF7ED;
}

.bg-warm-light {
  background-color: #FFF0ED;
}

.bg-divider {
  background-color: #ECECEC;
}

.border-accent {
  border-color: #C8553D;
}

.border-light {
  border-color: #F0ECE8;
}

.border-divider {
  border-color: #ECECEC;
}

.border-border {
  border-color: #E8E4E0;
}

.btn-primary {
  background: #C8553D;
  color: #FFFFFF;
  border-radius: 48rpx;
  font-weight: 600;
}

.btn-outline {
  border: 2rpx solid #C8553D;
  color: #C8553D;
  background: #FFFFFF;
  border-radius: 48rpx;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-wrap {
  display: flex;
  flex-wrap: wrap;
}

.price {
  color: #C8553D;
  font-weight: 700;
}

.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  margin-right: 8rpx;
}

.tag-accent {
  background: #FFF0ED;
  color: #C8553D;
}

.tag-gold {
  background: linear-gradient(135deg, #D4A574, #C8993E);
  color: #FFFFFF;
}

.tag-cn {
  background: #FFEBEE;
  color: #DE2910;
}

.tag-jp {
  background: #FFF0ED;
  color: #C8553D;
}

.divider {
  height: 16rpx;
  background: #ECECEC;
  margin: 0;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 28rpx;
  color: #2C2C2C;
  letter-spacing: 1rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: #9E9E9E;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #9E9E9E;
}

.avatar-ring {
  background: linear-gradient(135deg, #C8553D, #D4A574, #C8553D);
  padding: 4rpx;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.vip-pill {
  background: linear-gradient(135deg, #D4A574, #C8993E);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  letter-spacing: 1rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 40rpx;
  cursor: pointer;
  transition: background-color 0.15s ease;
}

.menu-item:active {
  background-color: #f9f9f9;
}

.menu-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.menu-icon-accent {
  background: #FFF0ED;
}

.menu-icon-gray {
  background: #F5F5F5;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: #2C2C2C;
}

.menu-arrow {
  color: #ccc;
  font-size: 36rpx;
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
}

.price-row:not(:last-child) {
  border-bottom: 1rpx solid #ECECEC;
}

.sku-pill {
  flex-shrink: 0;
  padding: 20rpx 40rpx;
  border-radius: 48rpx;
  border: 3rpx solid #E8E4E0;
  background: #FFFFFF;
  font-size: 26rpx;
  color: #2C2C2C;
  cursor: pointer;
  white-space: nowrap;
}

.sku-pill.active {
  border-color: #C8553D;
  background: #FFF0ED;
  color: #C8553D;
  font-weight: 500;
}

.lowest-row {
  background: linear-gradient(135deg, rgba(200, 85, 61, 0.06) 0%, rgba(243, 224, 219, 0.5) 100%);
}

.lowest-badge {
  background: #C8553D;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  letter-spacing: 1rpx;
}

.stock-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.stock-in {
  background: #EEF7EE;
  color: #3A8A3A;
}

.stock-out {
  background: #F5F0ED;
  color: #8C8C8C;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  cursor: pointer;
}

.action-label {
  font-size: 22rpx;
  color: #6B6B6B;
}

.no-scrollbar::-webkit-scrollbar {
  display: none;
}

.no-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

.nav-bar {
  background: #FFFFFF;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 50;
}

.nav-back {
  font-size: 44rpx;
  color: #2C2C2C;
  line-height: 1;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-center {
  font-size: 34rpx;
  font-weight: 600;
  color: #2C2C2C;
  letter-spacing: 1rpx;
}

.nav-right {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-icon {
  font-size: 40rpx;
  color: #6B6B6B;
}

.country-flag {
  font-size: 44rpx;
  flex-shrink: 0;
}

.country-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #2C2C2C;
}

.store-name {
  font-size: 22rpx;
  color: #9E9E9E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.price-original {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2C2C;
}

.price-cny {
  font-size: 22rpx;
  color: #9E9E9E;
}

.lowest-row .price-cny {
  font-size: 24rpx;
  font-weight: 700;
  color: #C8553D;
}

.price-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.price-right {
  text-align: right;
  flex-shrink: 0;
  margin-left: 24rpx;
}

.country-info {
  min-width: 0;
}
