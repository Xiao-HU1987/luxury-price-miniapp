.splash {
  width: 100vw;
  height: 100vh;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.splash-logo {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-text {
  font-size: 64rpx;
  font-weight: 700;
  color: #FF6600;
  letter-spacing: 8rpx;
}

.logo-subtitle {
  font-size: 24rpx;
  color: #999999;
  margin-top: 16rpx;
}
