.splash-container {
  width: 100vw;
  height: 100vh;
  background: #1A1A1A;
  position: relative;
  overflow: hidden;
}

.splash-content {
  width: 100%;
  height: 100%;
  position: relative;
}

.splash-image {
  width: 100%;
  height: 100%;
  display: block;
}

.splash-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
}

.splash-logo {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

.logo-text {
  font-size: 72rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 24rpx;
  text-indent: 24rpx;
  line-height: 1.25;
}

.logo-slogan {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
  letter-spacing: 6rpx;
  text-indent: 6rpx;
  margin-top: 24rpx;
  font-weight: 400;
}

.skip-btn {
  position: absolute;
  top: 80rpx;
  right: 40rpx;
  z-index: 20;
  background: rgba(0, 0, 0, 0.5);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

.skip-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 2rpx;
}

.spinner-line {
  width: 80rpx;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 2rpx;
  overflow: hidden;
  position: absolute;
  bottom: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
}

.spinner-line::after {
  content: '';
  display: block;
  width: 32rpx;
  height: 100%;
  background: #C8553D;
  border-radius: 2rpx;
  animation: slide 1.2s ease-in-out infinite;
}

@keyframes slide {
  0%   { transform: translateX(-32rpx); }
  50%  { transform: translateX(80rpx); }
  100% { transform: translateX(-32rpx); }
}

.splash-loading {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #1A1A1A 0%, #2C2C2C 100%);
}

.loading-logo {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-logo .logo-text {
  font-size: 72rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 24rpx;
  text-indent: 24rpx;
  line-height: 1.25;
}

.loading-logo .logo-slogan {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
  letter-spacing: 6rpx;
  text-indent: 6rpx;
  margin-top: 24rpx;
}

.loading-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 64rpx;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #C8553D;
  animation: pulse 1.6s ease-in-out infinite;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes pulse {
  0%, 80%, 100% {
    opacity: 0.2;
    transform: scale(0.8);
  }
  40% {
    opacity: 1;
    transform: scale(1);
  }
}
