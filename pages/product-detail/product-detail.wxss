.page {
  min-height: 100vh;
  background: #F0EBE8;
}

.nav-bar {
  background: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 50;
}

.nav-back {
  position: absolute;
  left: 32rpx;
  width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2C2C2C;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-center {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #2C2C2C;
  letter-spacing: 1rpx;
}

.nav-right {
  position: absolute;
  right: 32rpx;
  width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-icon {
  font-size: 36rpx;
  color: #6B6B6B;
}

.product-image {
  height: 500rpx;
  background: #F5F4F2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-placeholder {
  font-size: 160rpx;
  opacity: 0.85;
}

.product-info-section {
  padding: 40rpx;
  background: #FFFFFF;
}

.product-brand {
  font-size: 26rpx;
  font-weight: 500;
  color: #C8553D;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  margin-bottom: 12rpx;
}

.product-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #2C2C2C;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.product-name-en {
  font-size: 26rpx;
  color: #6B6B6B;
  margin-bottom: 20rpx;
}

.product-article {
  font-size: 24rpx;
  color: #6B6B6B;
}

.divider {
  height: 16rpx;
  background: #ECECEC;
}

.sku-section {
  padding: 40rpx;
  background: #FFFFFF;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-bottom: 28rpx;
}

.sku-scroll {
  white-space: nowrap;
}

.sku-pill {
  display: inline-block;
  padding: 20rpx 40rpx;
  border-radius: 48rpx;
  border: 2rpx solid #E8E4E0;
  background: #FFFFFF;
  font-size: 26rpx;
  color: #2C2C2C;
  margin-right: 20rpx;
  transition: all 0.2s ease;
}

.sku-pill.active {
  border-color: #C8553D;
  background: #FFF0ED;
  color: #C8553D;
  font-weight: 500;
}

.price-section {
  padding: 40rpx;
  background: #FFFFFF;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.section-header .section-title {
  font-size: 30rpx;
  margin-bottom: 0;
}

.exchange-link {
  font-size: 26rpx;
  color: #C8553D;
}

.price-list {
  border-radius: 28rpx;
  overflow: hidden;
  border: 1rpx solid #E8E4E0;
}

.price-row {
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  position: relative;
}

.price-row:not(:last-child) {
  border-bottom: 1rpx solid #ECECEC;
}

.price-row.lowest-row {
  background: linear-gradient(135deg, rgba(200, 85, 61, 0.06) 0%, rgba(243, 224, 219, 0.5) 100%);
}

.lowest-badge {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  background: #C8553D;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  letter-spacing: 1rpx;
}

.price-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.country-flag {
  font-size: 44rpx;
  flex-shrink: 0;
}

.country-info {
  min-width: 0;
}

.country-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #2C2C2C;
  display: block;
}

.country-name.lowest-name {
  color: #C8553D;
}

.store-name {
  font-size: 22rpx;
  color: #6B6B6B;
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.price-right {
  text-align: right;
  flex-shrink: 0;
  margin-left: 24rpx;
}

.price-original {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2C2C;
  display: block;
}

.price-cny {
  font-size: 24rpx;
  color: #9E9E9E;
  margin-top: 4rpx;
  display: block;
}

.price-row.lowest-row .price-cny {
  font-size: 24rpx;
  font-weight: 700;
  color: #C8553D;
}

.stock-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
  margin-left: 20rpx;
}

.stock-in {
  background: #EEF7EE;
  color: #3A8A3A;
}

.stock-out {
  background: #F5F0ED;
  color: #8C8C8C;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(100rpx + constant(safe-area-inset-bottom));
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  display: flex;
  justify-content: space-around;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #ECECEC;
  z-index: 40;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  cursor: pointer;
}

.action-icon {
  width: 36rpx;
  height: 36rpx;
  color: #6B6B6B;
}

.action-label {
  font-size: 22rpx;
  color: #6B6B6B;
}

.bottom-space {
  height: calc(200rpx + 100rpx + constant(safe-area-inset-bottom));
  height: calc(200rpx + 100rpx + env(safe-area-inset-bottom));
}