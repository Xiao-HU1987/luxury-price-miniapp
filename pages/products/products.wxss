.page {
  min-height: 100vh;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
}

.search-header {
  padding: 16rpx 32rpx 24rpx;
  padding-top: calc(16rpx + constant(safe-area-inset-top));
  padding-top: calc(16rpx + env(safe-area-inset-top));
  position: sticky;
  top: 0;
  z-index: 100;
  background: #FFFFFF;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.back-btn {
  font-size: 56rpx;
  font-weight: 300;
  color: #2C2C2C;
  line-height: 1;
  padding: 8rpx;
  flex-shrink: 0;
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F7F5F2;
  border: 1rpx solid #F0ECE8;
  border-radius: 48rpx;
  overflow: hidden;
  height: 76rpx;
}

.search-input {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  padding: 0 32rpx;
  font-size: 28rpx;
  font-family: inherit;
  color: #2C2C2C;
}

.search-input::placeholder {
  color: #9E9E9E;
}

.search-btn {
  background-color: #C8553D;
  color: #FFFFFF;
  border: none;
  padding: 0 32rpx;
  height: 76rpx;
  font-size: 28rpx;
  font-family: inherit;
  font-weight: 500;
  white-space: nowrap;
  border-radius: 0 48rpx 48rpx 0;
}

.filter-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-top: 24rpx;
  padding: 0 8rpx;
}

.filter-chip {
  font-size: 24rpx;
  color: #6B6B6B;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.filter-chip.active {
  color: #C8553D;
}

.filter-chevron {
  font-size: 20rpx;
}

.filter-divider {
  width: 1rpx;
  height: 24rpx;
  background-color: #ECECEC;
}

.sort-chip {
  font-size: 24rpx;
  color: #6B6B6B;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.product-list {
  flex: 1;
  padding: 0 32rpx;
  padding-bottom: 160rpx;
}

.result-count {
  padding: 24rpx 0 16rpx;
  font-size: 24rpx;
  color: #9E9E9E;
}

.empty {
  text-align: center;
  padding: 200rpx 0;
  color: #9E9E9E;
  font-size: 28rpx;
}

.product-card {
  background: #FFFFFF;
  border: 1rpx solid #E8E4E0;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  gap: 28rpx;
  transition: box-shadow 0.2s;
}

.product-card:active {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.product-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: #F7F5F2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}

.img-placeholder {
  font-size: 64rpx;
}

.product-badge {
  position: absolute;
  bottom: 0;
  left: 0;
  background: rgba(44, 44, 44, 0.75);
  color: #FFFFFF;
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 0 0 0 16rpx;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
}

.product-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.brand-name {
  font-size: 22rpx;
  color: #9E9E9E;
  margin-bottom: 6rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-bottom: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.price-row-card {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 16rpx;
}

.price-flags {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.price-cn, .price-jp {
  display: flex;
  align-items: center;
}

.flag-cn, .flag-jp {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  margin-right: 8rpx;
}

.flag-cn {
  background: #FFEBEE;
  color: #DE2910;
}

.flag-jp {
  background: #FFF0ED;
  color: #C8553D;
}

.price-num {
  font-size: 28rpx;
  font-weight: 700;
}

.price-num.red {
  color: #DE2910;
}

.price-num.accent {
  color: #C8553D;
}

.tag-arrival {
  font-size: 20rpx;
  color: #C8553D;
  background: #FFF0ED;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
  white-space: nowrap;
}

.filter-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.filter-panel {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 600rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #ECECEC;
}

.filter-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C2C2C;
}

.filter-reset {
  font-size: 28rpx;
  color: #C8553D;
}

.filter-body {
  flex: 1;
  padding: 24rpx 32rpx;
}

.filter-group {
  margin-bottom: 32rpx;
}

.filter-group-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #2C2C2C;
  margin-bottom: 16rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
}

.filter-option {
  padding: 16rpx 32rpx;
  background: #F7F5F2;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #6B6B6B;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.filter-option.active {
  background: #FFF0ED;
  color: #C8553D;
  border: 1rpx solid #C8553D;
}

.filter-footer {
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #ECECEC;
}

.btn-apply {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #C8553D;
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}