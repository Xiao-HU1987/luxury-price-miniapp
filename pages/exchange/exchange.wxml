<view class="page">
  <view class="content">
    <view class="converter-card">
      <view class="amount-section from">
        <view class="currency-info" bindtap="showFromCurrencyPicker">
          <text class="currency-flag">{{fromCountry.flag}}</text>
          <view class="currency-text">
            <text class="currency-name">{{fromCountry.name}}</text>
            <text class="currency-code">{{fromCurrency}}</text>
          </view>
          <text class="arrow">›</text>
        </view>
        <view class="amount-right">
          <text class="amount-symbol">{{fromCountry.currencySymbol}}</text>
          <input
            class="amount-input"
            type="digit"
            value="{{amount}}"
            bindinput="onAmountInput"
            placeholder="0"
          />
        </view>
      </view>

      <view class="swap-btn" bindtap="swapCurrency">
        <text class="swap-icon">⇅</text>
      </view>

      <view class="amount-section to">
        <view class="currency-info" bindtap="showToCurrencyPicker">
          <text class="currency-flag">{{toCountry.flag}}</text>
          <view class="currency-text">
            <text class="currency-name">{{toCountry.name}}</text>
            <text class="currency-code">{{toCurrency}}</text>
          </view>
          <text class="arrow">›</text>
        </view>
        <text class="converted-amount">{{toCountry.currencySymbol}}{{convertedDisplay}}</text>
      </view>

      <view class="rate-info">
        <text class="rate-text">1 {{fromCurrency}} = {{currentRateDisplay}} {{toCurrency}}</text>
        <view class="refresh-btn" bindtap="refreshRates">更新</view>
      </view>
    </view>

    <view class="update-time">汇率更新时间：{{updateTime}}</view>

    <view class="section">
      <text class="section-title">各国汇率（以 CNY 为基准）</text>
      <view class="rate-list">
        <view
          class="rate-row"
          wx:for="{{rateList}}"
          wx:key="code"
          data-currency="{{item.currency}}"
          bindtap="onRateTap"
        >
          <view class="rate-left">
            <text class="rate-flag">{{item.flag}}</text>
            <view class="rate-info-text">
              <text class="rate-country">{{item.name}} {{item.currency}}</text>
              <text class="rate-hint">1 CNY = {{item.rateDisplay}} {{item.currency}}</text>
            </view>
          </view>
          <text class="rate-value">{{item.currencySymbol}}{{item.rateDisplay}}</text>
        </view>
      </view>
    </view>
  </view>
</view>

<view class="picker-mask" wx:if="{{showFromPicker || showToPicker}}" bindtap="closeFromPicker">
  <view class="picker-content" catchtap="">
    <view class="picker-header">
      <text class="picker-title">选择货币</text>
      <text class="picker-close" bindtap="closeFromPicker">✕</text>
    </view>
    <scroll-view class="picker-list" scroll-y>
      <view
        class="picker-item"
        wx:for="{{countries}}"
        wx:key="code"
        data-currency="{{item.currency}}"
        bindtap="{{showFromPicker ? 'selectFromCurrency' : 'selectToCurrency'}}"
      >
        <text class="picker-flag">{{item.flag}}</text>
        <view class="picker-info">
          <text class="picker-name">{{item.name}}</text>
          <text class="picker-code">{{item.currency}} {{item.currencySymbol}}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
