.page {
  min-height: 100vh;
  background: #F0EBE8;
}

.content {
  padding: 40rpx 32rpx;
  padding-bottom: calc(200rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.converter-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #E8E4E0;
}

.amount-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-radius: 24rpx;
  min-height: 160rpx;
  box-sizing: border-box;
}

.amount-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
  max-width: 60%;
  overflow: visible;
}

.amount-section.from {
  background: #FFF0ED;
}

.amount-section.to {
  background: #FDF7ED;
}

.currency-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
}

.currency-flag {
  font-size: 56rpx;
}

.currency-text {
  display: flex;
  flex-direction: column;
}

.currency-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C2C2C;
  white-space: nowrap;
}

.currency-code {
  font-size: 24rpx;
  color: #6B6B6B;
  margin-top: 4rpx;
}

.arrow {
  font-size: 36rpx;
  color: #6B6B6B;
  margin-left: 8rpx;
}

.amount-symbol {
  font-size: 48rpx;
  font-weight: 700;
  color: #C8553D;
  line-height: 1.2;
}

.amount-input {
  font-size: 72rpx;
  font-weight: 700;
  color: #C8553D;
  letter-spacing: -1rpx;
  line-height: 1.2;
  text-align: right;
  margin-left: 0;
  height: 96rpx;
  min-width: 200rpx;
  padding: 0;
  border: none;
}

.converted-amount {
  font-size: 72rpx;
  font-weight: 700;
  color: #C8553D;
  letter-spacing: -1rpx;
  line-height: 1.2;
}

.swap-btn {
  display: flex;
  justify-content: center;
  margin: 32rpx 0;
}

.swap-btn .swap-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #E8765F;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #C8553D;
}

.rate-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #ECECEC;
}

.rate-text {
  font-size: 26rpx;
  color: #6B6B6B;
}

.refresh-btn {
  background: none;
  border: 2rpx solid #C8553D;
  color: #C8553D;
  font-size: 26rpx;
  font-weight: 500;
  padding: 10rpx 28rpx;
  border-radius: 40rpx;
}

.update-time {
  text-align: center;
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #6B6B6B;
}

.section {
  margin-top: 56rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

.rate-list {
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #E8E4E0;
  overflow: hidden;
}

.rate-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx;
}

.rate-row:not(:last-child) {
  border-bottom: 1rpx solid #ECECEC;
}

.rate-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.rate-flag {
  font-size: 48rpx;
}

.rate-info-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.rate-country {
  font-size: 28rpx;
  font-weight: 500;
  color: #2C2C2C;
}

.rate-hint {
  font-size: 22rpx;
  color: #6B6B6B;
  margin-top: 4rpx;
}

.rate-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #2C2C2C;
}

.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.picker-content {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #ECECEC;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C2C2C;
}

.picker-close {
  font-size: 32rpx;
  color: #9E9E9E;
}

.picker-list {
  flex: 1;
  padding: 0 32rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #ECECEC;
}

.picker-flag {
  font-size: 48rpx;
  margin-right: 24rpx;
}

.picker-info {
  flex: 1;
}

.picker-name {
  font-size: 28rpx;
  color: #2C2C2C;
}

.picker-code {
  font-size: 24rpx;
  color: #9E9E9E;
  margin-top: 8rpx;
}
