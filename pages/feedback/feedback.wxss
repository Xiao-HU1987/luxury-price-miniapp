.page {
  min-height: 100vh;
  background: #F7F6F4;
}

.nav-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0ECE8;
  box-sizing: border-box;
  display: block;
  align-items: initial;
  justify-content: initial;
}

.nav-inner {
  height: 88rpx;
  padding: 0 32rpx;
  position: relative;
  box-sizing: border-box;
  text-align: center;
  line-height: 88rpx;
}

.nav-back {
  position: absolute;
  left: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #F5F3F0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #2C2C2C;
  cursor: pointer;
  line-height: 1;
}

/* 标题容器用块级 view + width:100% + text-align:center 才能真正居中（<text> 行内元素不响应 width） */
.nav-title {
  width: 100%;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #2C2C2C;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.nav-right {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
}

.content {
  padding: 32rpx 24rpx 80rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.section {
  padding: 32rpx 0;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2C2C;
}

.section-required {
  color: #C8553D;
  font-size: 28rpx;
  margin-left: 4rpx;
}

.feedback-input {
  width: 100%;
  height: 240rpx;
  background: #F8F7F5;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.6;
  color: #2C2C2C;
}

.placeholder {
  color: #B8B8B8;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #B8B8B8;
  margin-top: 12rpx;
}

.divider {
  height: 1rpx;
  background: #F0ECE8;
}

.submit-btn {
  margin-top: 48rpx;
  background: linear-gradient(135deg, #FF7A45, #C8553D);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  height: 96rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  opacity: 0.6;
  color: #FFFFFF;
}

.footer-tip {
  margin-top: 40rpx;
  text-align: center;
}

.footer-tip text {
  font-size: 22rpx;
  color: #B0B0B0;
}