<view class="page">
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">‹</view>
    <text class="nav-title">浏览历史</text>
    <text class="clear-link" bindtap="onClear">清空</text>
  </view>

  <view class="content" wx:if="{{!loading}}">
    <view class="empty" wx:if="{{empty}}">
      <text class="empty-icon">🕐</text>
      <text class="empty-text">暂无浏览记录</text>
      <text class="empty-hint">去看看喜欢的商品吧</text>
    </view>

    <view class="list" wx:else>
      <view wx:for="{{groupedHistory}}" wx:key="date" class="date-section">
        <text class="date-label">{{item.date}}</text>
        <view
          class="history-card"
          wx:for="{{item.items}}"
          wx:key="id"
          wx:for-item="product"
          bindtap="onItemTap"
          data-id="{{product.id}}"
        >
          <view class="product-img">
            <text class="img-placeholder">👜</text>
          </view>
          <view class="product-info">
            <text class="brand-name">{{product.brandName || ''}}</text>
            <text class="product-name">{{product.name}}</text>
            <view class="price-row-card">
              <view class="price-flags">
                <view class="price-cn">
                  <text class="flag-cn">中</text>
                  <text class="price-num red">¥{{product.cnPriceStr || '0'}}</text>
                </view>
                <view wx:if="{{product.hasJpPrice}}" class="price-jp">
                  <text class="flag-jp">日</text>
                  <text class="price-num accent">¥{{product.jpPriceCnyStr}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="swipe-hint">向左滑动可删除</view>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>