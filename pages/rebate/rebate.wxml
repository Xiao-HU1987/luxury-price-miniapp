<view class="page">
  <view class="nav-bar" style="height: {{navBarTotalHeight}}px; padding-top: {{statusBarHeight}}px; box-sizing: border-box;">
    <text class="nav-title">返点优惠</text>
  </view>

  <view class="content" style="padding-top: {{contentPaddingTop}}px;">
    <view class="section" wx:if="{{rebates.length > 0}}">
      <view class="section-header">
        <text class="section-title">返点优惠</text>
        <view class="more-btn" bindtap="goToMoreRebates">
          <text>更多</text>
          <text class="arrow">›</text>
        </view>
      </view>
      <view class="coupon-list">
        <view
          class="coupon-card"
          wx:for="{{rebates}}"
          wx:key="id"
          data-coupon="{{item}}"
          bindtap="onCouponTap"
        >
          <view class="coupon-left">
            <view class="coupon-logo">{{item.logo}}</view>
            <view class="coupon-info">
              <text class="coupon-name">{{item.name}}</text>
              <text wx:if="{{item.description}}" class="coupon-desc">{{item.description}}</text>
              <text wx:if="{{item.rate}}" class="coupon-desc">返点比例：{{item.rate}}%</text>
              <view wx:if="{{item.isVipOnly}}" class="vip-tag">VIP专属</view>
            </view>
          </view>
          <view class="coupon-right">
            <view class="btn-action {{item.status === 'used' ? 'btn-used' : 'btn-get'}}">
              {{item.statusText}}
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-header">
        <text class="section-title">热门商品</text>
        <view class="more-btn" bindtap="goToProducts">
          <text>更多</text>
          <text class="arrow">›</text>
        </view>
      </view>
      <view class="product-list">
        <view
          class="product-card"
          wx:for="{{products}}"
          wx:key="id"
          data-product-id="{{item.id}}"
          bindtap="onProductTap"
        >
          <view class="product-img">
            <text class="img-placeholder">👜</text>
          </view>
          <view class="product-info">
            <text class="product-name">{{item.name}}</text>
            <text class="product-article">{{item.articleNo}}</text>
            <view class="price-row">
              <view class="price-cn">
                <text class="flag-cn">中</text>
                <text class="price-num red">¥{{item.cnPriceStr}}</text>
              </view>
              <view wx:if="{{item.hasJpPrice}}" class="price-jp">
                <text class="flag-jp">日</text>
                <text class="price-num accent">¥{{item.jpPriceCnyStr}}</text>
              </view>
            </view>
          </view>
          <text class="tag-arrival">到手价</text>
        </view>
      </view>
    </view>
  </view>
</view>