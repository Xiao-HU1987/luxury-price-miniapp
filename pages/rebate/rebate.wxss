.page {
  min-height: 100vh;
  background: #F0EDEA;
}

.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
  border-bottom: 1rpx solid #F0ECE8;
  box-sizing: border-box;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2C2C2C;
  letter-spacing: 1rpx;
}

.content {
  padding: 24rpx;
  padding-bottom: calc(120rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2C2C2C;
  letter-spacing: 0.5rpx;
}

.more-btn {
  font-size: 26rpx;
  color: #9E9E9E;
  display: flex;
  align-items: center;
}

.more-btn .arrow {
  font-size: 28rpx;
  margin-left: 4rpx;
}

.coupon-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.coupon-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid #E8E4E0;
  border-radius: 24rpx;
  padding: 28rpx;
}

.coupon-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.coupon-logo {
  width: 88rpx;
  height: 88rpx;
  background: #F7F5F2;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.coupon-info {
  flex: 1;
  min-width: 0;
}

.coupon-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C2C2C;
}

.coupon-desc {
  font-size: 24rpx;
  color: #6B6B6B;
  margin-top: 8rpx;
}

.vip-tag {
  display: inline-block;
  background: linear-gradient(135deg, #D4A574, #C8993E);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 40rpx;
  margin-top: 12rpx;
  letter-spacing: 0.5rpx;
}

.empty-tip {
  text-align: center;
  color: #9E9E9E;
  font-size: 26rpx;
  padding: 60rpx 0;
}

.coupon-right {
  margin-left: 16rpx;
}

.btn-action {
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.btn-get {
  background: #C8553D;
  color: #FFFFFF;
}

.btn-used {
  background: #FFFFFF;
  color: #9E9E9E;
  border: 1rpx solid #E8E4E0;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.product-card {
  background: #FFFFFF;
  border: 1rpx solid #E8E4E0;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  gap: 28rpx;
  position: relative;
}

.product-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: #F7F5F2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.img-placeholder {
  font-size: 72rpx;
}

.product-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C2C2C;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.product-article {
  font-size: 24rpx;
  color: #9E9E9E;
  margin-top: 8rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.price-row {
  display: flex;
  align-items: flex-end;
  gap: 24rpx;
  margin-top: 16rpx;
}

.price-cn, .price-jp {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.flag-cn, .flag-jp {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.flag-cn {
  background: #FFEBEE;
  color: #DE2910;
}

.flag-jp {
  background: #FFF0ED;
  color: #C8553D;
}

.price-num {
  font-size: 28rpx;
  font-weight: 700;
}

.price-num.red {
  color: #DE2910;
}

.price-num.accent {
  color: #C8553D;
}

.tag-arrival {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 20rpx;
  color: #C8553D;
  background: #FFF0ED;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
  white-space: nowrap;
}