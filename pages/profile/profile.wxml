<view class="page">
  <view class="profile-header">
    <view class="user-card">
      <view class="avatar-ring">
        <view class="avatar">
          <text class="avatar-icon">👤</text>
        </view>
      </view>
      <view class="user-info">
        <view class="user-name-row">
          <text class="nickname">{{userInfo.nickname || '比惠用户'}}</text>
          <view wx:if="{{userInfo.is_vip}}" class="vip-pill">VIP会员</view>
        </view>
        <view class="user-id" catchtap="copyUserId">
          <text class="id-text">ID: {{userInfo.user_id || 'BH20250001'}}</text>
          <text wx:if="{{userInfo.user_id}}" class="copy-tip">点击复制</text>
        </view>
      </view>
      <view class="edit-btn">›</view>
    </view>
  </view>

  <view wx:if="{{!userInfo.phone}}" class="phone-bind-card">
    <view class="phone-bind-content">
      <text class="phone-bind-icon">📱</text>
      <text class="phone-bind-text">绑定手机号，享受更多服务</text>
    </view>
    <view class="phone-bind-btn" bindtap="onBindPhone">立即绑定</view>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="goToOrders">
      <view class="menu-icon accent">📦</view>
      <text class="menu-text">我的订单</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="goToFavorites">
      <view class="menu-icon accent">❤️</view>
      <text class="menu-text">我的收藏</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="goToHistory">
      <view class="menu-icon accent">🕐</view>
      <text class="menu-text">浏览历史</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="goToCoupons">
      <view class="menu-icon accent">🎫</view>
      <text class="menu-text">我的优惠券</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="goToDemands">
      <view class="menu-icon accent">📋</view>
      <text class="menu-text">我的需求</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="goToSettings">
      <view class="menu-icon gray">⚙️</view>
      <text class="menu-text">账号设置</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="goToPrivacy">
      <view class="menu-icon gray">📝</view>
      <text class="menu-text">隐私政策</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="goToAbout">
      <view class="menu-icon gray">ℹ️</view>
      <text class="menu-text">关于比惠</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="footer">
    <text class="app-version">比惠 v1.0.0</text>
  </view>
</view>