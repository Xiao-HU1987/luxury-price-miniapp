.page {
  min-height: 100vh;
  background: #FFFFFF;
}

.header-section {
  background: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid #F0ECE8;
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
}

.header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2C2C2C;
  letter-spacing: 4rpx;
}

.search-wrapper {
  padding: 24rpx 32rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #F7F5F2;
  border: 1rpx solid #E8E4E0;
  border-radius: 48rpx;
  padding: 0 28rpx;
  height: 84rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  color: #A0A0A0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #2C2C2C;
}

.hero-section {
  padding: 0 32rpx 32rpx;
}

.hero-banner {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  height: 320rpx;
}

.hero-bg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(44, 44, 44, 0.7) 0%, rgba(44, 44, 44, 0.2) 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 40rpx 48rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.hero-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.content-section {
  padding: 0 32rpx 100rpx;
  padding-bottom: calc(100rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2C2C2C;
  letter-spacing: 1rpx;
}

.section-more {
  display: flex;
  align-items: center;
}

.more-text {
  font-size: 26rpx;
  color: #9E9E9E;
}

.more-arrow {
  font-size: 26rpx;
  color: #9E9E9E;
  margin-left: 4rpx;
}

.product-card {
  background: #FFFFFF;
  border: 1rpx solid #E8E4E0;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  gap: 28rpx;
  transition: box-shadow 0.2s;
}

.product-card:active {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.product-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: #F7F5F2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.img-placeholder {
  font-size: 64rpx;
}

.product-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-top {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-size: 22rpx;
  color: #9E9E9E;
  margin-bottom: 6rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-bottom: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.product-article {
  font-size: 22rpx;
  color: #9E9E9E;
}

.price-row-card {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 16rpx;
}

.price-flags {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.price-cn, .price-jp {
  display: flex;
  align-items: center;
}

.flag-cn, .flag-jp {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  margin-right: 8rpx;
}

.flag-cn {
  background: #FFEBEE;
  color: #DE2910;
}

.flag-jp {
  background: #FFF0ED;
  color: #C8553D;
}

.price-num {
  font-size: 28rpx;
  font-weight: 700;
}

.price-num.red {
  color: #DE2910;
}

.price-num.accent {
  color: #C8553D;
}

.tag-arrival {
  font-size: 20rpx;
  color: #C8553D;
  background: #FFF0ED;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
  white-space: nowrap;
}

.footer-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #9E9E9E;
  margin-top: 8rpx;
}
