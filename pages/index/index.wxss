.page {
  min-height: 100vh;
  background: #F7F5F2;
}

.header-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: linear-gradient(180deg, #FFFFFF 0%, #F7F5F2 100%);
  padding: 0 32rpx 24rpx;
  z-index: 100;
  box-sizing: border-box;
}

.header-inner {
  height: 96rpx;
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.app-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #2C2C2C;
  letter-spacing: 4rpx;
}

.app-subtitle {
  font-size: 22rpx;
  color: #9E9E9E;
}

.search-wrap {
  padding: 0;
}

.search-box {
  height: 80rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  gap: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.search-ico {
  font-size: 28rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #2C2C2C;
}

.hot-row {
  margin-top: 16rpx;
  white-space: nowrap;
}

.hot-list {
  display: inline-flex;
  gap: 16rpx;
}

.hot-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: #666;
  background: rgba(200, 85, 61, 0.06);
  border-radius: 24rpx;
}

.list-wrap {
  padding: 20rpx 32rpx 120rpx;
  padding-bottom: calc(120rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.state-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 0 80rpx;
}

.state-ico {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.state-text {
  font-size: 28rpx;
  color: #666;
}

.state-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
}

.count-row {
  font-size: 24rpx;
  color: #999;
  margin: 8rpx 4rpx 20rpx;
}

.card {
  display: flex;
  gap: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
  transition: transform 0.15s;
}

.card:active {
  transform: scale(0.99);
}

.card-img {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #F7F5F2;
  flex-shrink: 0;
}

.card-img-real {
  width: 100%;
  height: 100%;
}

.card-img-fb {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #F7F5F2, #EDE8E3);
}

.img-fb-ico {
  font-size: 72rpx;
}

.card-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 4rpx 12rpx;
  background: rgba(44, 44, 44, 0.78);
  color: #FFFFFF;
  font-size: 20rpx;
  border-radius: 8rpx;
  backdrop-filter: blur(4px);
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding: 4rpx 0;
  position: relative;
}

.card-brand {
  font-size: 20rpx;
  color: #999;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.35;
}

.card-sub-name {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-prices {
  display: flex;
  gap: 20rpx;
  margin-top: auto;
  padding-top: 12rpx;
  flex-wrap: wrap;
}

.price-unit {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.price-flag {
  width: 32rpx;
  height: 32rpx;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.price-flag.cn {
  background: #DE2910;
}

.price-flag.jp {
  background: #C8553D;
}

.price-flag.kr {
  background: #003478;
}

.price-num {
  font-size: 28rpx;
  font-weight: 700;
}

.price-num.red {
  color: #DE2910;
}

.price-num.accent {
  color: #C8553D;
}

.card-tag {
  position: absolute;
  right: 0;
  bottom: 4rpx;
  padding: 4rpx 12rpx;
  font-size: 18rpx;
  color: #C8553D;
  background: rgba(200, 85, 61, 0.08);
  border-radius: 8rpx;
}

.bottom-gap {
  height: 40rpx;
}
