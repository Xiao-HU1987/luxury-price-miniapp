<view class="page">
  <view class="header-section">
    <view class="header-content">
      <text class="header-title">比惠</text>
    </view>
    <view class="search-wrapper" style="padding-right: {{menuButtonRight + menuButtonWidth + 20}}px;">
      <view class="search-bar">
        <text class="search-icon">🔍</text>
        <input
          class="search-input"
          placeholder="输入货号/商品名称"
          value="{{searchKeyword}}"
          bindinput="onSearchInput"
          bindconfirm="onSearch"
          confirm-type="search"
        />
      </view>
    </view>
  </view>

  <view class="hero-section">
    <view class="hero-banner">
      <image class="hero-bg" src="https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=luxury%20brand%20shopping%20bag%20elegant%20minimalist%20fashion%20photography%20golden%20hour&image_size=landscape_16_9" mode="aspectFill" />
      <view class="hero-overlay">
        <text class="hero-title">全球奢侈品比价</text>
        <text class="hero-subtitle">覆盖13个国家 · 实时汇率换算</text>
      </view>
    </view>
  </view>

  <view class="content-section">
    <view class="section-header">
      <text class="section-title">热门比价</text>
      <view class="section-more" bindtap="goToProducts">
        <text class="more-text">更多</text>
        <text class="more-arrow">›</text>
      </view>
    </view>

    <view
      class="product-card"
      wx:for="{{products}}"
      wx:key="id"
      data-product-id="{{item.id}}"
      bindtap="onProductTap"
    >
      <view class="product-img">
        <text class="img-placeholder">👜</text>
      </view>
      <view class="product-info">
        <view class="product-top">
          <text class="brand-name">{{item.brandName}}</text>
          <text class="product-name">{{item.name}}</text>
          <text class="product-article">{{item.articleNo}}</text>
        </view>
        <view class="price-row-card">
          <view class="price-flags">
            <view class="price-cn">
              <text class="flag-cn">中</text>
              <text class="price-num red">¥{{item.cnPriceStr}}</text>
            </view>
            <view wx:if="{{item.hasJpPrice}}" class="price-jp">
              <text class="flag-jp">日</text>
              <text class="price-num accent">¥{{item.jpPriceCnyStr}}</text>
            </view>
          </view>
          <text class="tag-arrival">到手价</text>
        </view>
      </view>
    </view>

    <text class="footer-hint">日本最低到手价(实时更新)</text>
  </view>
</view>
