.page {
  min-height: 100vh;
  background: #F0EBE8;
  display: flex;
  flex-direction: column;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  padding: 28rpx 32rpx;
  padding-top: calc(28rpx + constant(safe-area-inset-top));
  padding-top: calc(28rpx + env(safe-area-inset-top));
  border-bottom: 1rpx solid #F0ECE8;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #2C2C2C;
  cursor: pointer;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2C2C2C;
  letter-spacing: 1rpx;
}

.search-bar {
  padding: 24rpx 32rpx;
  background: #FFFFFF;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #F7F5F2;
  border: 1rpx solid #E8E4E0;
  border-radius: 48rpx;
  padding: 0 28rpx;
  height: 84rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  color: #9E9E9E;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #2C2C2C;
}

.country-filter {
  white-space: nowrap;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
}

.country-pill {
  display: inline-block;
  padding: 16rpx 32rpx;
  border-radius: 48rpx;
  border: 2rpx solid #E8E4E0;
  background: #FFFFFF;
  font-size: 26rpx;
  color: #6B6B6B;
  margin-right: 16rpx;
}

.country-pill.active {
  border-color: #C8553D;
  background: #FFF0ED;
  color: #C8553D;
  font-weight: 500;
}

.category-tabs {
  display: flex;
  background: #FFFFFF;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #F0ECE8;
}

.category-tab {
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #6B6B6B;
  position: relative;
}

.category-tab.active {
  color: #C8553D;
  font-weight: 600;
}

.category-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #C8553D;
  border-radius: 2rpx;
}

.store-list {
  flex: 1;
  padding: 24rpx 32rpx;
}

.empty {
  text-align: center;
  padding: 200rpx 0;
  color: #9E9E9E;
  font-size: 28rpx;
}

.store-card {
  display: flex;
  background: #FFFFFF;
  border: 1rpx solid #E8E4E0;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  gap: 24rpx;
}

.store-card:active {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.store-card-image {
  width: 180rpx;
  height: 180rpx;
  background: #F7F5F2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.store-card-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.store-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.store-card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C2C2C;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store-card-rating {
  font-size: 24rpx;
  color: #C5A47E;
  white-space: nowrap;
}

.store-card-location {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.store-card-loc-text {
  font-size: 24rpx;
  color: #6B6B6B;
}

.store-card-tag {
  font-size: 20rpx;
  color: #C8553D;
  background: #FFF0ED;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.store-card-address {
  font-size: 22rpx;
  color: #9E9E9E;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store-card-brands {
  font-size: 22rpx;
  color: #C5A47E;
  margin-top: 8rpx;
}