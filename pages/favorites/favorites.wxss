.page {
  min-height: 100vh;
  background: #FFFFFF;
}

.nav-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0ECE8;
  padding: 24rpx 32rpx;
  padding-top: calc(24rpx + constant(safe-area-inset-top));
  padding-top: calc(24rpx + env(safe-area-inset-top));
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back {
  position: absolute;
  left: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 48rpx;
  color: #2C2C2C;
  line-height: 1;
  cursor: pointer;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C2C2C;
  letter-spacing: 0.5rpx;
}

.nav-count {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: #9E9E9E;
}

.content {
  padding-bottom: 160rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
}

.empty-text {
  margin-top: 30rpx;
  font-size: 32rpx;
  color: #666;
}

.empty-hint {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #999;
}

.product-card {
  background: #FFFFFF;
  border: 1rpx solid #E8E4E0;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx 32rpx;
  display: flex;
  gap: 28rpx;
  position: relative;
}

.product-card:active {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.product-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: #F7F5F2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.img-placeholder {
  font-size: 64rpx;
}

.product-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.brand-name {
  font-size: 22rpx;
  color: #9E9E9E;
  margin-bottom: 6rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-bottom: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.product-article {
  font-size: 22rpx;
  color: #9E9E9E;
}

.price-row-card {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 16rpx;
}

.price-flags {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.price-cn, .price-jp {
  display: flex;
  align-items: center;
}

.flag-cn, .flag-jp {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  margin-right: 8rpx;
}

.flag-cn {
  background: #FFEBEE;
  color: #DE2910;
}

.flag-jp {
  background: #FFF0ED;
  color: #C8553D;
}

.price-num {
  font-size: 28rpx;
  font-weight: 700;
}

.price-num.red {
  color: #DE2910;
}

.price-num.accent {
  color: #C8553D;
}

.product-heart {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  font-size: 36rpx;
  color: #C8553D;
  line-height: 1;
}

.swipe-hint {
  text-align: center;
  font-size: 24rpx;
  color: #9E9E9E;
  padding: 48rpx 32rpx 64rpx;
}

.loading {
  display: flex;
  justify-content: center;
  padding: 200rpx;
  color: #999;
  font-size: 28rpx;
}