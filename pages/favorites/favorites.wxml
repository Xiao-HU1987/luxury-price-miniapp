<view class="page">
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">‹</view>
    <text class="nav-title">我的收藏</text>
    <text class="nav-count">{{list.length}} 件商品</text>
  </view>

  <view class="content" wx:if="{{!loading}}">
    <view class="empty" wx:if="{{empty}}">
      <text class="empty-icon">❤️</text>
      <text class="empty-text">暂无收藏</text>
      <text class="empty-hint">去逛逛发现喜欢的商品吧</text>
    </view>

    <view class="list" wx:else>
      <view
        class="product-card"
        wx:for="{{list}}"
        wx:key="id"
        bindtap="onItemTap"
        data-id="{{item.id}}"
      >
        <view class="product-img">
          <text class="img-placeholder">👜</text>
        </view>
        <view class="product-info">
          <text class="brand-name">{{item.brandName || 'Unknown'}}</text>
          <text class="product-name">{{item.name}}</text>
          <text class="product-article">{{item.articleNo || ''}}</text>
          <view class="price-row-card">
            <view class="price-flags">
              <view class="price-cn">
                <text class="flag-cn">中</text>
                <text class="price-num red">¥{{item.cnPriceStr || '0'}}</text>
              </view>
              <view wx:if="{{item.hasJpPrice}}" class="price-jp">
                <text class="flag-jp">日</text>
                <text class="price-num accent">¥{{item.jpPriceCnyStr}}</text>
              </view>
            </view>
          </view>
        </view>
        <view class="product-heart" catchtap="onRemove" data-id="{{item.id}}">❤️</view>
      </view>
    </view>

    <view class="swipe-hint">向左滑动可取消收藏</view>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>