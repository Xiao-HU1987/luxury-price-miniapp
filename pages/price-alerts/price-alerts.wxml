<view class="page">
  <view class="header">
    <view class="header-row">
      <text class="header-title">价格提醒</text>
      <text class="header-count" wx:if="{{totalCount > 0}}">共 {{totalCount}} 条</text>
    </view>
    <text class="header-subtitle">商品降价到目标价格后将推送通知给您</text>
  </view>

  <view class="content" wx:if="{{!loading}}">
    <view class="empty" wx:if="{{empty}}">
      <text class="empty-icon">🔔</text>
      <text class="empty-text">暂无价格提醒</text>
      <text class="empty-hint">可在商品详情页设置价格提醒</text>
    </view>

    <view class="list" wx:else>
      <view
        class="alert-card"
        wx:for="{{list}}"
        wx:key="productId"
      >
        <view class="card-img">
          <image
            wx:if="{{item.mainImage}}"
            src="{{item.mainImage}}"
            class="img"
            mode="aspectFill"
          />
          <text wx:else class="img-placeholder">👜</text>
        </view>

        <view class="card-info">
          <text class="brand">{{item.brandName}}</text>
          <text class="name">{{item.displayName || item.nameCn || item.nameEn}}</text>

          <view class="price-row">
            <view class="best-price-wrap">
              <text class="best-label">全球最低价</text>
              <text class="best-price">¥{{item.bestPriceStr}}</text>
            </view>
          </view>

          <view class="target-row">
            <view class="target-tag">
              <text class="target-icon">🔔</text>
              <text class="target-text">目标价 ¥{{item.targetPriceStr}}</text>
            </view>
            <view class="status-chip {{item.reached ? 'reached' : 'not-reached'}}">
              {{item.reached ? '达标' : '未达标'}}
            </view>
          </view>
        </view>

        <view class="card-delete" catchtap="handleDelete" data-product-id="{{item.productId}}">
          删除提醒
        </view>
      </view>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
